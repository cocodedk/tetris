#!/usr/bin/env bash
# Require a Conventional Commit subject: type(scope)!: summary. No exceptions: write merges
# and reverts as e.g. "chore: merge main" or "revert: drop hold".
set -euo pipefail
subject=$(head -n 1 "$1")
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'
if ! [[ "$subject" =~ $pattern ]]; then
  echo "commit-msg: the subject is not a Conventional Commit:" >&2
  echo "  $subject" >&2
  echo "  expected e.g. 'feat(play): add hold' or 'fix: stop double lock'" >&2
  exit 1
fi
